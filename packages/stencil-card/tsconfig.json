{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "h.Fragment",
    "experimentalDecorators": true,
    "rootDir": "./",
    "strict": true,
    "noEmit": true
  },
  "include": ["src"]
}
